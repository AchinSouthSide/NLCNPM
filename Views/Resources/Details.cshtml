@model NLCNPM.Models.Resource
@{ ViewData["Title"] = Model.Title; }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Tài nguyên</a></li><li class="breadcrumb-item active">Chi tiết</li></ol></nav>
<article class="card"><div class="card-body p-4"><span class="badge text-bg-primary">@Model.Status</span><h1 class="mt-3">@Model.Title</h1><p class="text-secondary">Đăng bởi @Model.Owner?.DisplayName · @Model.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><p style="white-space:pre-wrap">@Model.Description</p><p><strong>Tệp:</strong> @Model.OriginalFileName · <strong>Lượt tải:</strong> @Model.DownloadCount</p>
@if (Model.Status == NLCNPM.Models.ResourceStatus.Approved) { <a class="btn btn-primary" asp-action="Download" asp-route-id="@Model.Id">Tải xuống</a> }
@if (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.OwnerId) { <hr/><h2 class="h5">Tải phiên bản mới</h2><form asp-action="AddVersion" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"><div class="mb-3"><input type="file" name="file" class="form-control" required /></div><div class="mb-3"><input name="note" class="form-control" maxlength="1000" placeholder="Mô tả thay đổi" /></div><button class="btn btn-outline-primary">Gửi phiên bản</button></form> }
<hr/><h2 class="h4">Đánh giá và thảo luận</h2><p>Điểm trung bình: @(Model.Ratings.Count == 0 ? "Chưa có" : Model.Ratings.Average(x => x.Score).ToString("0.0") + " / 5")</p>
@if (User.Identity?.IsAuthenticated == true && Model.Status == NLCNPM.Models.ResourceStatus.Approved) { <div class="d-flex gap-3 flex-wrap"><form asp-action="Rate" asp-route-id="@Model.Id" method="post" class="d-flex gap-2"><select name="score" class="form-select"><option value="5">5 sao</option><option value="4">4 sao</option><option value="3">3 sao</option><option value="2">2 sao</option><option value="1">1 sao</option></select><button class="btn btn-outline-primary">Đánh giá</button></form><form asp-action="Comment" asp-route-id="@Model.Id" method="post" class="d-flex gap-2"><input name="body" maxlength="2000" class="form-control" placeholder="Viết bình luận" required/><button class="btn btn-outline-primary">Gửi</button></form></div> }
<div class="mt-3">@foreach (var comment in Model.Comments.Where(c => !c.IsHidden).OrderByDescending(c => c.CreatedAtUtc)) { <div class="border-bottom py-2"><strong>@comment.User?.DisplayName</strong><small class="text-secondary ms-2">@comment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small><p class="mb-0">@comment.Body</p></div> }</div>
</div></article>
