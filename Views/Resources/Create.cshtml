@{ ViewData["Title"] = "Chia sẻ tài liệu"; }
<h1>Chia sẻ tài liệu</h1><p class="text-secondary">Tệp tối đa 25 MB. Tài liệu mới sẽ chờ quản trị viên kiểm duyệt.</p>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label" for="title">Tiêu đề</label><input id="title" name="title" class="form-control" maxlength="200" required /></div><div class="mb-3"><label class="form-label" for="description">Mô tả</label><textarea id="description" name="description" class="form-control" maxlength="2000" rows="5" required></textarea></div><div class="mb-3"><label class="form-label" for="file">Tệp (PDF, DOCX, PPTX, XLSX, TXT)</label><input id="file" name="file" type="file" class="form-control" required /></div><button class="btn btn-primary align-self-start">Gửi kiểm duyệt</button></form>
