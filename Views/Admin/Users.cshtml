@model IReadOnlyList<NLCNPM.Models.AdminUserRowViewModel>
@{ ViewData["Title"] = "Quản lý người dùng"; }
<h1>Quản lý tài khoản</h1>@if (TempData["Notice"] is string notice) { <div class="alert alert-success">@notice</div> }<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Email</th><th>Họ tên</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var u in Model) { <tr><td>@u.Email</td><td>@u.DisplayName</td><td>@string.Join(", ", u.Roles)</td><td>@(u.IsActive ? "Hoạt động" : "Đã khóa")</td><td><form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@u.Id"/><input type="hidden" name="active" value="@(!u.IsActive)"/><button class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(u.IsActive ? "Khóa" : "Mở khóa")</button></form></td></tr> }</tbody></table></div>
